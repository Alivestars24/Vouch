# Defaults to services/backend/vouch.db, independent of the invocation directory.
VOUCH_DATABASE_URL=
VOUCH_ENVIRONMENT=development
VOUCH_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
VOUCH_WORKER_POLL_SECONDS=1.0
VOUCH_AUTH_MODE=fixture
# Local authenticated configuration is generated by npm.cmd run supabase:provision.
# Never put secret keys or runtime DB passwords in NEXT_PUBLIC_ variables.
# VOUCH_SUPABASE_URL=http://127.0.0.1:54321
# VOUCH_SUPABASE_PUBLISHABLE_KEY=
# VOUCH_SUPABASE_SECRET_KEY=
