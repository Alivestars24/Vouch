NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8010/api/v1
# Keep fixture mode unless local authenticated provisioning has completed.
NEXT_PUBLIC_AUTH_MODE=fixture
# Browser-safe publishable key only. Never use service_role or database credentials here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Leave false until Google provider credentials and exact callback allowlists are configured.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false
